{
  "name": "dsh-caveman",
  "version": "0.4.0",
  "description": "让 AI 少说废话的 DeepSeek Harness 插件（官方 Caveman 完整移植）：输出精简 + 输入代理压缩 + 浏览提纯三层体系，设置页专属管理与独立岩石图标，零外部依赖",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "src",
    "scripts",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "token",
    "caveman",
    "输出精简",
    "省token"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
